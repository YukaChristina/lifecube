{
  "cli": {
    "version": "18.11.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "environment": "development",
      "channel": "development",
      "env": {
        "APP_VARIANT": "development",
        "EXPO_PUBLIC_APP_ENV": "development",
        "EXPO_IMAGE_UTILS_NO_SHARP": "1",
        "EAS_BUILD_DISABLE_NPM_CACHE": "1",
        "EXPO_NO_DOTENV": "1"
      }
    },
    "preview": {
      "distribution": "store",
      "autoIncrement": true,
      "environment": "preview",
      "channel": "preview",
      "env": {
        "APP_VARIANT": "preview",
        "EXPO_PUBLIC_APP_ENV": "preview",
        "EXPO_IMAGE_UTILS_NO_SHARP": "1",
        "EAS_BUILD_DISABLE_NPM_CACHE": "1",
        "EXPO_NO_DOTENV": "1"
      }
    },
    "firebase": {
      "distribution": "internal",
      "autoIncrement": true,
      "env": {
        "APP_VARIANT": "production",
        "EXPO_PUBLIC_APP_ENV": "production",
        "EXPO_IMAGE_UTILS_NO_SHARP": "1",
        "EAS_BUILD_DISABLE_NPM_CACHE": "1",
        "EXPO_NO_DOTENV": "1"
      }
    },
    "production": {
      "autoIncrement": true,
      "environment": "production",
      "channel": "production",
      "env": {
        "APP_VARIANT": "production",
        "EXPO_PUBLIC_APP_ENV": "production",
        "EXPO_IMAGE_UTILS_NO_SHARP": "1",
        "EAS_BUILD_DISABLE_NPM_CACHE": "1",
        "EXPO_NO_DOTENV": "1"
      }
    }
  },
  "submit": {
    "preview": {
      "ios": {
        "ascAppId": "6766719683"
      }
    },
    "production": {
      "ios": {
        "ascAppId": "6766719683"
      }
    }
  }
}
